{
  "name": "auditguard",
  "version": "0.1.0-alpha.1",
  "description": "Automated security auditor for JS/TS repos. GitHub Action for static analysis, dependency audit, and auto-fix PRs.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate-fixtures": "bash scripts/validate-fixtures.sh",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "security",
    "audit",
    "github-action",
    "eslint",
    "semgrep",
    "static-analysis",
    "sast",
    "vulnerability"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "eslint": "^9.0.0",
    "eslint-plugin-no-secrets": "^2.3.0",
    "eslint-plugin-security": "^4.0.0"
  }
}
